{
    "compilerOptions":{
        "target": "ES2022",
        "module": "nodenext",
        "types":["node", "@playwright/test"],
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "playwright.config.js",
        "tests/**/*.ts",
        "pages/**/*.ts",
        "fixture/**/*.ts",
        "test-data/**/*.ts"
    ]
}